{
  // partyparty.party — one Worker serves the static landing page (../site) and
  // streams the big app download + Sparkle appcast from an R2 bucket (Pages caps
  // files at 25 MB; the .app zip is ~60-100 MB). Deploy with: make deploy-site
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partyparty-site",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  "account_id": "4e958c1f2621ced0354e94826590e34f",

  // Landing page (index.html etc.). Served for any path that isn't an R2 file.
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Passwordless sign-in email (last-resort fallback binding; primary path
  // is MXroute SMTP from noreply@partyparty.party).
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Downloads live here (partyparty.zip, appcast.xml). Created by deploy-site.sh.
  // Also stores cert-broker install records, diagnostics, and OTA payloads.
  "r2_buckets": [
    { "binding": "DL", "bucket_name": "partyparty-dl" }
  ],

  // Identity, sessions, and linked-Mac state. The historic database name is
  // retained to avoid a destructive production migration.
  "d1_databases": [
    { "binding": "DB", "database_name": "partyparty-events", "database_id": "5344bf77-632f-45b4-b0f5-13f49faaf94a" }
  ],

  // Cert broker (the Plex pattern): linked installs get slugged hostnames under
  // BROKER_BASE; the broker writes DNS-01 TXT + DNS-only A records for them.
  // Needs the CF_DNS_TOKEN secret (wrangler secret put CF_DNS_TOKEN — Zone→DNS→Edit).
  "vars": {
    // Passwordless auth sends through MXroute SMTP first. Preferred production
    // secret: AUTH_EMAIL_SERVER="smtps://user:pass@SERVER.mxrouting.net:465".
    // Split-secret fallback: MXROUTE_SMTP_HOST/PORT/USER/PASS.
    // Optional from override: AUTH_EMAIL_FROM="partyparty <noreply@partyparty.party>".
    // The EMAIL binding above is only a last-resort fallback.
    // NOTE: the dev-login bypass (AUTH_DEV_LINKS/AUTH_DEV_DIRECT/AUTH_DEV_EMAILS
    // + the AUTH_DEV_SECRET secret) is intentionally NOT set in production —
    // production sign-in is Apple/Google/email only. authDevMode() short-circuits
    // to false without these, so the code stays inert here. To use it locally,
    // set them in a .dev.vars file (never in this committed prod config).
    "BROKER_BASE": "partyparty.party",
    // The partyparty.party zone — machine hostnames' grey A records and ACME
    // TXT challenges are written here.
    "CF_ZONE_ID": "f156a8f56d299f1d0451bbb9223c1f08"
  },

  // Bind the product domain and machine namespace. The wildcard route is only
  // operational plumbing for certificate-backed LAN hostnames.
  "routes": [
    { "pattern": "partyparty.party", "custom_domain": true },
    { "pattern": "*.partyparty.party/*", "zone_name": "partyparty.party" }
  ],

  // Self-heal the machine-namespace DNS anchor.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
