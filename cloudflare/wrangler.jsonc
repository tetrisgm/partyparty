{
  // PartyParty.party - one Worker serves the static website and LAN broker.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partyparty-site",
  "main": "worker.js",
  "compatibility_date": "2026-07-07",
  "account_id": "4e958c1f2621ced0354e94826590e34f",

  // Landing page (index.html etc.). Served for any path that isn't an R2 file.
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Stores cert-broker install records and wildcard certificate material.
  "r2_buckets": [
    { "binding": "DL", "bucket_name": "partyparty-dl" }
  ],

  // Registration is intentionally anonymous, but minting an install writes to
  // R2. Apply a network-level per-address bound before the existing short
  // Cache API throttle so a burst cannot turn into unbounded storage writes.
  "ratelimits": [
    {
      "name": "REGISTRATION_RATE_LIMITER",
      "namespace_id": "6794880742",
      "simple": { "limit": 30, "period": 60 }
    }
  ],

  // Aggregate launch conversion only. Events contain destination, allowlisted
  // placement, and a count—never an address, user agent, referrer, or identity.
  "analytics_engine_datasets": [
    { "binding": "LAUNCH_ANALYTICS", "dataset": "partyparty_launch" }
  ],

  // The relay Durable Object is gone: guest media and the room API go straight to
  // the relay origin, never through a Worker. The delete migration retires the
  // class so its storage is released.
  "migrations": [
    { "tag": "relay-v1", "new_sqlite_classes": ["RelayRoom"] },
    { "tag": "relay-v2-remove-do", "deleted_classes": ["RelayRoom"] }
  ],

  // Cert broker (the Plex pattern): anonymous installs get memorable hostnames under
  // BROKER_BASE; the broker writes DNS-01 TXT + DNS-only A records for them.
  // Needs the CF_DNS_TOKEN secret (wrangler secret put CF_DNS_TOKEN - Zone→DNS→Edit).
  "vars": {
    "BROKER_BASE": "partyparty.party",
    // The PartyParty.party zone - machine hostnames' grey A records and ACME
    // TXT challenges are written here.
    "CF_ZONE_ID": "f156a8f56d299f1d0451bbb9223c1f08"
  },

  // Bind the product domain and machine namespace. The wildcard route is only
  // operational plumbing for certificate-backed LAN hostnames.
  "routes": [
    { "pattern": "partyparty.party", "custom_domain": true },
    { "pattern": "*.partyparty.party/*", "zone_name": "partyparty.party" }
  ],

  // Self-heal the machine-namespace DNS anchor.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
