{
  // party.ramine.net — one Worker serves the static landing page (../site) and
  // streams the big app download + Sparkle appcast from an R2 bucket (Pages caps
  // files at 25 MB; the .app zip is ~60-100 MB). Deploy with: make deploy-site
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partyparty-site",
  "main": "worker.js",
  "compatibility_date": "2024-12-01",
  "account_id": "4e958c1f2621ced0354e94826590e34f",

  // Landing page (index.html etc.). Served for any path that isn't an R2 file.
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Passwordless sign-in email. Requires Email Sending to be onboarded for
  // ramine.net in Cloudflare Email Service.
  "send_email": [
    { "name": "EMAIL" }
  ],

  // Downloads live here (partyparty.zip, appcast.xml). Created by deploy-site.sh.
  // Also stores cert-broker install records (broker/<id>.json) AND published set
  // media (event/<slug>/<set>.m4a + peaks + cover).
  "r2_buckets": [
    { "binding": "DL", "bucket_name": "partyparty-dl" }
  ],

  // Event pages database (Phase-1 web): events + published sets. Create once:
  //   wrangler d1 create partyparty-events
  // paste the printed database_id below, then apply cloudflare/schema.sql:
  //   wrangler d1 execute partyparty-events --remote --file=schema.sql
  "d1_databases": [
    { "binding": "DB", "database_name": "partyparty-events", "database_id": "5344bf77-632f-45b4-b0f5-13f49faaf94a" }
  ],

  // Cert broker (the Plex pattern): linked installs get slugged hostnames under
  // BROKER_BASE; the broker writes DNS-01 TXT + DNS-only A records for them.
  // Needs the CF_DNS_TOKEN secret (wrangler secret put CF_DNS_TOKEN — Zone→DNS→Edit).
  "vars": {
    // Passwordless auth sends through MXroute SMTP first. Preferred production
    // secret: AUTH_EMAIL_SERVER="smtps://user:pass@SERVER.mxrouting.net:465".
    // Split-secret fallback: MXROUTE_SMTP_HOST/PORT/USER/PASS.
    // Optional from override: AUTH_EMAIL_FROM="partyparty <signin@ramine.net>".
    // The EMAIL binding above is only a last-resort fallback.
    "AUTH_DEV_LINKS": "1",
    "AUTH_DEV_DIRECT": "1",
    "AUTH_DEV_EMAILS": "ramine@ramine.net",
    "BROKER_BASE": "party.ramine.net",
    "CF_ZONE_ID": "56cc234f25b32b90b9bc3b872a3d58fc"
  },

  // Bind the Worker to the apex-of-record for the app. custom_domain:true makes
  // wrangler provision the DNS record + edge cert in the ramine.net zone.
  "routes": [
    { "pattern": "party.ramine.net", "custom_domain": true },
    { "pattern": "ramine.party.ramine.net", "custom_domain": true }
  ],

  // 1-minute GC sweep of the live_installs presence registry (expire dead rows +
  // delete grey slug-host A records orphaned by a crashed Mac). The FIRST cron on
  // this Worker — correctness lives in the read path; this only keeps R2/DNS tidy.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
