{
  // PartyParty platform - groups, nights, and the people who come to them.
  //
  // A SECOND Worker on purpose. partyparty-site carries the certificate broker,
  // DNS and relay registration, which a party in progress depends on minute to
  // minute. Deploying this must never be able to take those down.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partyparty-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-07",
  "account_id": "4e958c1f2621ced0354e94826590e34f",

  // Groups, members, events, signups, tokens and the mail outbox.
  //
  // The id below is a PLACEHOLDER so `wrangler dev --local` works with a file
  // on disk. It is not a real database and a deploy with it still set would
  // fail. Creating the real one is a deliberate act:
  //   wrangler d1 create partyparty-app        (paste the id it prints here)
  //   for f in migrations/*.sql; do wrangler d1 execute partyparty-app --remote --file=$f; done
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "partyparty-app",
      "database_id": "00000000-0000-0000-0000-000000000000",
      // wrangler tracks which of these have run in a d1_migrations table, so
      // applying twice is a no-op. Running the files by hand is not: an
      // ALTER TABLE ADD COLUMN fails the second time and takes the rest of the
      // batch with it.
      "migrations_dir": "migrations"
    }
  ],

  // The broker's keyspace, read and written only to reserve handles so a group
  // name can never collide with a machine or join name minted for a Mac.
  "r2_buckets": [
    { "binding": "DL", "bucket_name": "partyparty-dl" }
  ],

  // Only the platform paths. Everything else on the zone stays with
  // partyparty-site, including the apex, the machine namespace and r-<token>.
  "routes": [
    { "pattern": "partyparty.party/@*", "zone_name": "partyparty.party" },
    { "pattern": "partyparty.party/j/*", "zone_name": "partyparty.party" },
    { "pattern": "partyparty.party/m/*", "zone_name": "partyparty.party" },
    { "pattern": "partyparty.party/g/*", "zone_name": "partyparty.party" },
    { "pattern": "partyparty.party/api/v1/*", "zone_name": "partyparty.party" },
    { "pattern": "partyparty.party/auth/*", "zone_name": "partyparty.party" },
    // The DJ's own pages. Missing these sends /manage and /signin to the site
    // Worker, which knows nothing about them - the platform would look broken
    // on the real domain while working perfectly on localhost.
    { "pattern": "partyparty.party/manage", "zone_name": "partyparty.party" },
    { "pattern": "partyparty.party/signin", "zone_name": "partyparty.party" }
  ],

  // Sign in with Apple. None of these are secrets - they identify the
  // configuration, they do not authorise anything. The key itself is
  // APPLE_SIWA_KEY, set with `wrangler secret put` and never written here.
  //
  //   Services ID  fm.partyparty.web   (Sign In with Apple, primary
  //                fm.partyparty.app, domain partyparty.party, return URL
  //                https://partyparty.party/auth/apple/callback)
  //   Key          "PartyParty Sign In", created 2026-08-07
  "vars": {
    "APPLE_CLIENT_ID": "fm.partyparty.web",
    "APPLE_TEAM_ID": "52WM463HR2",
    "APPLE_KEY_ID": "9DLLL4UAR8"
  },

  "observability": { "enabled": true }
}
