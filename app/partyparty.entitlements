<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core Audio process tap (system-audio capture) under hardened runtime.
	     Without this, a notarized/hardened build is denied audio access
	     outright — the permission prompt can't even grant it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
