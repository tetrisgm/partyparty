# built binary + bundled helpers (regenerated by `make`)
/PartyParty
/assets/ppcapture
/assets/mediamtx
/assets/ffmpeg
# runtime output: HLS segments, generated certs, mediamtx config, letsencrypt
/run/
*.log
# except the playback soaks: AGENTS.md requires the log itself as the receipt
# for any claim about where a real AVPlayer sat, so these are evidence, not
# build noise, and they have to survive the session that produced them.
!docs/receipts/*.log
.DS_Store
# certs / private keys - NEVER commit these (all generated at runtime)
*.pem
*.key
*.crt
*.p12
auto.crt
auto.key
# Swift package build artifacts
/app/.build/
/app/.build-app-store/
/app/.swiftpm/
# assembled .app bundle output
/build/
# Cloudflare deploy tooling (wrangler installed locally)
/cloudflare/node_modules/
.wrangler/
# generated submission artifacts
testdata/music/*.flac
/dist/
/PartyParty*.zip

# Codex loop logs (local)
codex/logs/
node_modules/

# generated sync-test audio
scripts/synctest/*.wav
/pp-port443
